# Copy to `.env.local` and set when the FastAPI backend is available.
# Leave unset to run against local mock data (src/Data via src/api).
# VITE_API_URL=http://localhost:8000

# Supabase (business portal auth — Content Manager feature)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
